student@gbl:~$ cat ex31.c
#include <time.h>
#include <mpi.h>

int main(int argc, char *argv[])
{
    int rank, size;
    MPI_Init(&argc, &argv);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    int N=100;
    int local_n=N/size;
    int local_count=0;
    int search_number;
    int global_count=0;
    int *local_array = (int *)malloc(local_n * sizeof(int));
    int *array = (int *)malloc(N * sizeof(int));
    if (rank == 0)
    {
        printf("Generated Array: ");
        for (int i = 0; i < N; i++)
        {
            array[i] = rand() % 10;
            printf("%d ", array[i]);
        }
        printf("\nEnter number to search: ");

        scanf("%d", &search_number);
    }
    MPI_Bcast(&search_number, 1, MPI_INT, 0, MPI_COMM_WORLD);
    MPI_Scatter(array,local_n, MPI_INT,local_array,local_n, MPI_INT, 0, MPI_COMM_WORLD);
    for (int i = 0; i < local_n; i++)
    {
        if (local_array[i] == search_number)
            local_count++;
    }

    printf("Process %d received %d elements and found %d occurrences\n",
           rank, local_n, local_count);
    MPI_Reduce(&local_count, &global_count, 1, MPI_INT,
               MPI_SUM, 0, MPI_COMM_WORLD);
    if (rank == 0)
    {
        printf("\nTotal frequency of %d = %d\n", search_number, global_count);
        free(array);
    }

    free(local_array);
    MPI_Finalize();
    return 0;
}

