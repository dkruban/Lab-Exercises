import java.util.*;

public class PlayfairCipher {
    private char[][] matrix = new char[5][5];

    public PlayfairCipher(String key) {
        generateMatrix(key.toUpperCase().replace("J", "I"));
    }

    private void generateMatrix(String key) {
        String alphabet = "ABCDEFGHIKLMNOPQRSTUVWXYZ";
        String combined = key + alphabet;
        StringBuilder uniqueChars = new StringBuilder();
        
        for (char c : combined.toCharArray()) {
            if (Character.isLetter(c) && uniqueChars.indexOf(String.valueOf(c)) == -1) {
                uniqueChars.append(c);
            }
        }

        for (int i = 0; i < 25; i++) {
            matrix[i / 5][i % 5] = uniqueChars.charAt(i);
        }
    }

    private String prepareText(String text) {
        text = text.toUpperCase().replace("J", "I").replaceAll("[^A-Z]", "");
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < text.length(); i++) {
            sb.append(text.charAt(i));
            if (i + 1 < text.length() && text.charAt(i) == text.charAt(i + 1)) {
                sb.append('X');
            }
        }
        if (sb.length() % 2 != 0) sb.append('X');
        return sb.toString();
    }

    private int[] findPos(char c) {
        for (int r = 0; r < 5; r++)
            for (int col = 0; col < 5; col++)
                if (matrix[r][col] == c) return new int[]{r, col};
        return null;
    }

    public String process(String text, boolean encrypt) {
        String prepared = prepareText(text);
        StringBuilder result = new StringBuilder();
        int shift = encrypt ? 1 : 4; // Right/Down for encrypt, Left/Up for decrypt

        for (int i = 0; i < prepared.length(); i += 2) {
            int[] p1 = findPos(prepared.charAt(i));
            int[] p2 = findPos(prepared.charAt(i + 1));

            if (p1[0] == p2[0]) { // Same Row
                result.append(matrix[p1[0]][(p1[1] + shift) % 5]);
                result.append(matrix[p2[0]][(p2[1] + shift) % 5]);
            } else if (p1[1] == p2[1]) { // Same Column
                result.append(matrix[(p1[0] + shift) % 5][p1[1]]);
                result.append(matrix[(p2[0] + shift) % 5][p2[1]]);
            } else { // Rectangle Rule
                result.append(matrix[p1[0]][p2[1]]);
                result.append(matrix[p2[0]][p1[1]]);
            }
        }
        return result.toString();
    }

    public void printMatrix() {
        System.out.println("Key Matrix:");
        for (char[] row : matrix) {
            for (char c : row) System.out.print(c + " ");
            System.out.println();
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter Key: ");
        PlayfairCipher pf = new PlayfairCipher(sc.nextLine());
        System.out.print("Enter Plaintext: ");
        String plain = sc.nextLine();

        pf.printMatrix();
        String cipher = pf.process(plain, true);
        System.out.println("\nCiphertext: " + cipher);
        System.out.println("Decrypted: " + pf.process(cipher, false));
    }
}



