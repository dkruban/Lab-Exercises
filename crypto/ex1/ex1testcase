import java.util.Scanner;

public class VigenereCipher {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Plaintext: ");
        String text = sc.nextLine().toUpperCase().replaceAll("[^A-Z]", "");

        System.out.print("Enter Keyword: ");
        String keyword = sc.next().toUpperCase();

        // 1. Encryption
        StringBuilder cipherText = new StringBuilder();
        System.out.println("\n--- ENCRYPTION STEPS ---");
        for (int i = 0, j = 0; i < text.length(); i++) {
            char pChar = text.charAt(i);
            char kChar = keyword.charAt(j % keyword.length());
            
            // Formula: Ei = (Pi + Ki) mod 26
            int eIdx = (pChar - 'A' + (kChar - 'A')) % 26;
            char eChar = (char) (eIdx + 'A');
            cipherText.append(eChar);
            
            System.out.printf("%c + %c (Key) -> (%d + %d) %% 26 = %d -> %c\n", 
                              pChar, kChar, (pChar-'A'), (kChar-'A'), eIdx, eChar);
            j++; 
        }
        System.out.println("Final Ciphertext: " + cipherText);

        // 2. Decryption
        StringBuilder plainText = new StringBuilder();
        System.out.println("\n--- DECRYPTION STEPS ---");
        for (int i = 0, j = 0; i < cipherText.length(); i++) {
            char cChar = cipherText.charAt(i);
            char kChar = keyword.charAt(j % keyword.length());

            // Formula: Di = (Ci - Ki + 26) mod 26
            int dIdx = (cChar - kChar + 26) % 26;
            char dChar = (char) (dIdx + 'A');
            plainText.append(dChar);

            System.out.printf("%c - %c (Key) -> (%d - %d + 26) %% 26 = %d -> %c\n", 
                              cChar, kChar, (cChar-'A'), (kChar-'A'), dIdx, dChar);
            j++;
        }
        System.out.println("Final Decrypted Text: " + plainText);
        sc.close();
    }
}


