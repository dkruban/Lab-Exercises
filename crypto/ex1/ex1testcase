import java.util.Scanner;

public class AffineCipher {
    // Standard alphabet size
    private static final int M = 26;

    // GCD function to check if 'a' and 26 are coprime
    private static int gcd(int a, int b) {
        return b == 0 ? a : gcd(b, a % b);
    }

    // Find Modular Multiplicative Inverse of 'a'
    private static int getModInverse(int a) {
        for (int x = 1; x < M; x++) {
            if ((a * x) % M == 1) return x;
        }
        return -1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter text (Letters only): ");
        String text = sc.nextLine().toUpperCase();

        System.out.print("Enter key 'a' (must be coprime with 26): ");
        int a = sc.nextInt();
        if (gcd(a, M) != 1) {
            System.out.println("Error: 'a' and 26 are not coprime!");
            return;
        }

        System.out.print("Enter key 'b': ");
        int b = sc.nextInt();

        // 1. Encryption Process
        StringBuilder cipher = new StringBuilder();
        System.out.println("\n--- ENCRYPTION STEPS ---");
        for (char c : text.toCharArray()) {
            if (Character.isLetter(c)) {
                int x = c - 'A';
                int encryptedPos = (a * x + b) % M;
                char encryptedChar = (char) (encryptedPos + 'A');
                cipher.append(encryptedChar);
                System.out.printf("%c -> Index %d: (%d*%d + %d) %% 26 = %d -> %c\n", 
                                  c, x, a, x, b, encryptedPos, encryptedChar);
            }
        }
        System.out.println("Ciphertext: " + cipher);

        // 2. Decryption Process
        int aInv = getModInverse(a);
        StringBuilder plain = new StringBuilder();
        System.out.println("\n--- DECRYPTION STEPS ---");
        System.out.println("Modular Inverse of a: " + aInv);

        for (char c : cipher.toString().toCharArray()) {
            int y = c - 'A';
            // Logic to handle negative results in modulo
            int decryptedPos = (aInv * (y - b)) % M;
            if (decryptedPos < 0) decryptedPos += M;
            
            char decryptedChar = (char) (decryptedPos + 'A');
            plain.append(decryptedChar);
            System.out.printf("%c -> Index %d: %d*(%d - %d) %% 26 = %d -> %c\n", 
                              c, y, aInv, y, b, decryptedPos, decryptedChar);
        }
        System.out.println("Decrypted Text: " + plain);
        sc.close();
    }
}


