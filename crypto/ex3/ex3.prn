import java.util.Scanner;

public class EuclideanAlgorithm {

    // Basic Euclidean Algorithm (Recursive)
    public static int findGCD(int a, int b) {
        if (a == 0) return b;
        System.out.println("Step: gcd(" + a + ", " + b + ") -> " + b + " % " + a + " = " + (b % a));
        return findGCD(b % a, a);
    }

    // Extended Euclidean Algorithm
    // Returns array [gcd, x, y]
    public static int[] extendedGCD(int a, int b) {
        if (a == 0) {
            return new int[] { b, 0, 1 };
        }
        int[] vals = extendedGCD(b % a, a);
        int gcd = vals[0];
        int x1 = vals[1];
        int y1 = vals[2];

        // Update x and y using results of recursive call
        int x = y1 - (b / a) * x1;
        int y = x1;

        System.out.printf("Backtrack: gcd=%d, x=%d, y=%d\n", gcd, x, y);
        return new int[] { gcd, x, y };
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter first number (a): ");
        int a = sc.nextInt();
        System.out.print("Enter second number (b): ");
        int b = sc.nextInt();

        System.out.println("\n--- BASIC GCD STEPS ---");
        int gcd = findGCD(a, b);
        System.out.println("Final GCD: " + gcd);

        System.out.println("\n--- EXTENDED GCD STEPS (Coefficients) ---");
        int[] result = extendedGCD(a, b);
        System.out.printf("\nEquation: (%d * %d) + (%d * %d) = %d\n", 
                          a, result[1], b, result[2], result[0]);
        
        sc.close();
    }
}


