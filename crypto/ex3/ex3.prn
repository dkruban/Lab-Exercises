import java.util.*;

public class PrimitiveRootFinder {
    // Utility function for modular exponentiation: (base^exp) % mod
    static long power(long base, long exp, long mod) {
        long res = 1;
        base %= mod;
        while (exp > 0) {
            if (exp % 2 == 1) res = (res * base) % mod;
            base = (base * base) % mod;
            exp /= 2;
        }
        return res;
    }

    // Finds unique prime factors of n
    static void findFactors(Set<Integer> factors, int n) {
        while (n % 2 == 0) {
            factors.add(2);
            n /= 2;
        }
        for (int i = 3; i <= Math.sqrt(n); i += 2) {
            while (n % i == 0) {
                factors.add(i);
                n /= i;
            }
        }
        if (n > 2) factors.add(n);
    }

    // Finds the smallest primitive root of prime n
    static int findSmallestRoot(int n) {
        if (n <= 1) return -1;
        int phi = n - 1;
        Set<Integer> factors = new HashSet<>();
        findFactors(factors, phi);

        for (int r = 2; r <= phi; r++) {
            boolean isRoot = true;
            for (int q : factors) {
                // If r^(phi/q) % n == 1, then r is NOT a primitive root
                if (power(r, phi / q, n) == 1) {
                    isRoot = false;
                    break;
                }
            }
            if (isRoot) return r;
        }
        return -1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a prime number: ");
        int n = sc.nextInt();

        int root = findSmallestRoot(n);
        if (root != -1) {
            System.out.println("\nSmallest Primitive Root: " + root);
            System.out.println("Powers of " + root + " mod " + n + ":");
            for (int i = 1; i < n; i++) {
                System.out.print(power(root, i, n) + " ");
            }
            System.out.println();
        } else {
            System.out.println("No primitive root found.");
        }
        sc.close();
    }
}

