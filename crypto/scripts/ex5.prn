//RSA


import java.math.BigInteger;
import java.security.SecureRandom;
import java.util.Scanner;

/**
 * RSA Implementation Step-by-Step
 */
public class RSAEncryption {
    private BigInteger n, d, e;
    private int bitlen = 1024;

    /**
     * STEP 1: Key Generation
     */
    public RSAEncryption(int bits) {
        this.bitlen = bits;
        SecureRandom r = new SecureRandom();
        
        // 1.1 Choose two distinct prime numbers p and q
        BigInteger p = new BigInteger(bitlen / 2, 100, r);
        BigInteger q = new BigInteger(bitlen / 2, 100, r);
        
        // 1.2 Compute n = p * q (The modulus)
        n = p.multiply(q);
        
        // 1.3 Compute Euler's Totient: phi(n) = (p-1)(q-1)
        BigInteger m = (p.subtract(BigInteger.ONE)).multiply(q.subtract(BigInteger.ONE));
        
        // 1.4 Choose e such that 1 < e < phi(n) and gcd(e, phi(n)) = 1
        e = new BigInteger("65537"); // Standard prime for e
        
        // 1.5 Compute d (Private Key): d = e^-1 mod phi(n)
        d = e.modInverse(m);
        
        System.out.println("--- KEY GENERATION STEPS ---");
        System.out.println("p: " + p);
        System.out.println("q: " + q);
        System.out.println("n (Modulus): " + n);
        System.out.println("e (Public Exponent): " + e);
        System.out.println("d (Private Exponent): " + d + "\n");
    }

    /**
     * STEP 2: Encryption
     * Formula: C = M^e mod n
     */
    public BigInteger encrypt(BigInteger message) {
        return message.modPow(e, n);
    }

    /**
     * STEP 3: Decryption
     * Formula: M = C^d mod n
     */
    public BigInteger decrypt(BigInteger ciphertext) {
        return ciphertext.modPow(d, n);
    }

    // --- TEST CASE ---
    public static void main(String[] args) {
        // Initialize RSA with 512-bit security for speed in testing
        RSAEncryption rsa = new RSAEncryption(512);

        String testData = "HELLO RSA";
        System.out.println("--- EXECUTION ---");
        System.out.println("Original String: " + testData);

        // Convert string to BigInteger for math operations
        BigInteger plaintext = new BigInteger(testData.getBytes());
        System.out.println("Plaintext (BigInt): " + plaintext);

        // Perform Encryption
        BigInteger ciphertext = rsa.encrypt(plaintext);
        System.out.println("Ciphertext: " + ciphertext);

        // Perform Decryption
        BigInteger decryptedBI = rsa.decrypt(ciphertext);
        System.out.println("Decrypted (BigInt): " + decryptedBI);

        // Convert back to String
        String result = new String(decryptedBI.toByteArray());
        System.out.println("Decrypted String: " + result);
    }
}


=== RSA CONSOLE TEST CASE ===
Public Key:  (e=7, n=143)
Private Key: (d=103, n=143)
-----------------------------
Step 1: Original Message Integer  -> 9
Step 2: Encrypted (Ciphertext)    -> 48
Step 3: Decrypted Result          -> 9

SUCCESS: Decrypted message matches original!


//  Diife helaman 

import java.math.BigInteger;
import java.security.SecureRandom;

public class DiffieHellman {
    public static void main(String[] args) {
        SecureRandom random = new SecureRandom();

        // STEP 1: Public Parameters (Shared by everyone)
        // p is a large prime, g is a primitive root modulo p
        BigInteger p = BigInteger.probablePrime(512, random); 
        BigInteger g = new BigInteger("2"); 

        System.out.println("--- PUBLIC PARAMETERS ---");
        System.out.println("Prime (p): " + p);
        System.out.println("Generator (g): " + g + "\n");

        // STEP 2: Alice generates Private Key (a) and Public Key (A)
        // A = g^a mod p
        BigInteger a = new BigInteger(512, random); 
        BigInteger A = g.modPow(a, p);

        // STEP 3: Bob generates Private Key (b) and Public Key (B)
        // B = g^b mod p
        BigInteger b = new BigInteger(512, random); 
        BigInteger B = g.modPow(b, p);

        System.out.println("--- KEY EXCHANGE ---");
        System.out.println("Alice's Public Key (A): " + A);
        System.out.println("Bob's Public Key (B):   " + B + "\n");

        // STEP 4: Alice computes Shared Secret (s)
        // s = B^a mod p
        BigInteger aliceSecret = B.modPow(a, p);

        // STEP 5: Bob computes Shared Secret (s)
        // s = A^b mod p
        BigInteger bobSecret = A.modPow(b, p);

        System.out.println("--- SHARED SECRET ---");
        System.out.println("Alice's Computed Secret: " + aliceSecret);
        System.out.println("Bob's Computed Secret:   " + bobSecret);

        if (aliceSecret.equals(bobSecret)) {
            System.out.println("\nSUCCESS: Secrets match! They can now encrypt data.");
        }
    }
}



--- PUBLIC PARAMETERS ---
