// playfair



import java.util.Scanner;

public class PlayfairCipher {
    private static final int SIZE = 5;
    private char[][] matrix = new char[SIZE][SIZE];
    private String key;

    public PlayfairCipher(String key) {
        this.key = prepareKey(key);
        generateMatrix();
    }

    // Prepare key: uppercase, remove duplicates, replace J with I
    private String prepareKey(String key) {
        key = key.toUpperCase().replaceAll("[^A-Z]", "").replace('J', 'I');
        StringBuilder result = new StringBuilder();
        boolean[] seen = new boolean[26];
        for (char c : key.toCharArray()) {
            int idx = c - 'A';
            if (!seen[idx]) {
                seen[idx] = true;
                result.append(c);
            }
        }
        return result.toString();
    }

    // Generate 5x5 matrix for Playfair cipher
    private void generateMatrix() {
        boolean[] used = new boolean[26];
        used['J' - 'A'] = true; // J is omitted
        int index = 0;

        // Fill matrix with key first
        for (char c : key.toCharArray()) {
            matrix[index / SIZE][index % SIZE] = c;
            used[c - 'A'] = true;
            index++;
        }

        // Fill remaining letters
        for (char c = 'A'; c &lt;= 'Z'; c++) {
            if (!used[c - 'A']) {
                matrix[index / SIZE][index % SIZE] = c;
                used[c - 'A'] = true;
                index++;
            }
        }
    }

    // Prepare plaintext: uppercase, remove non-letters, replace J with I, handle double letters and odd length
    private String prepareText(String text) {
        text = text.toUpperCase().replaceAll("[^A-Z]", "").replace('J', 'I');
        StringBuilder prepared = new StringBuilder();

        for (int i = 0; i &lt; text.length(); i++) {
            char c1 = text.charAt(i);
            if (i == text.length() - 1) {
                prepared.append(c1);
                prepared.append('X'); // append X if last single char
                break;
            }
            char c2 = text.charAt(i + 1);
            if (c1 == c2) {
                prepared.append(c1);
                prepared.append('X'); // insert X between repeated letters
            } else {
                prepared.append(c1);
                prepared.append(c2);
                i++; // skip next char since pair is processed
            }
        }
        return prepared.toString();
    }

    // Find position of a character in matrix
    private int[] findPosition(char c) {
        for (int r = 0; r &lt; SIZE; r++) {
            for (int col = 0; col &lt; SIZE; col++) {
                if (matrix[r][col] == c) {
                    return new int[]{r, col};
                }
            }
        }
        return null; // should never happen
    }

    // Encrypt plaintext using Playfair cipher rules
    public String encrypt(String plainText) {
        String prepared = prepareText(plainText);
        StringBuilder cipherText = new StringBuilder();

        for (int i = 0; i &lt; prepared.length(); i += 2) {
            char a = prepared.charAt(i);
            char b = prepared.charAt(i + 1);

            int[] posA = findPosition(a);
            int[] posB = findPosition(b);

            if (posA[0] == posB[0]) { // same row
                cipherText.append(matrix[posA[0]][(posA[1] + 1) % SIZE]);
                cipherText.append(matrix[posB[0]][(posB[1] + 1) % SIZE]);
            } else if (posA[1] == posB[1]) { // same column
                cipherText.append(matrix[(posA[0] + 1) % SIZE][posA[1]]);
                cipherText.append(matrix[(posB[0] + 1) % SIZE][posB[1]]);
            } else { // rectangle
                cipherText.append(matrix[posA[0]][posB[1]]);
                cipherText.append(matrix[posB[0]][posA[1]]);
            }
        }
        return cipherText.toString();
    }

    // Decrypt ciphertext using Playfair cipher rules
    public String decrypt(String cipherText) {
        StringBuilder plainText = new StringBuilder();

        for (int i = 0; i &lt; cipherText.length(); i += 2) {
            char a = cipherText.charAt(i);
            char b = cipherText.charAt(i + 1);

            int[] posA = findPosition(a);
            int[] posB = findPosition(b);

            if (posA[0] == posB[0]) { // same row
                plainText.append(matrix[posA[0]][(posA[1] + SIZE - 1) % SIZE]);
                plainText.append(matrix[posB[0]][(posB[1] + SIZE - 1) % SIZE]);
            } else if (posA[1] == posB[1]) { // same column
                plainText.append(matrix[(posA[0] + SIZE - 1) % SIZE][posA[1]]);
                plainText.append(matrix[(posB[0] + SIZE - 1) % SIZE][posB[1]]);
            } else { // rectangle
                plainText.append(matrix[posA[0]][posB[1]]);
                plainText.append(matrix[posB[0]][posA[1]]);
            }
        }
        return plainText.toString();
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter key for Playfair cipher: ");
        String key = sc.nextLine();

        PlayfairCipher pc = new PlayfairCipher(key);

        System.out.print("Enter plaintext: ");
        String plaintext = sc.nextLine();

        // Step 1: Prepare plaintext (inside encrypt)
        String preparedText = pc.prepareText(plaintext);
        System.out.println("Prepared plaintext (after handling duplicates and J-&gt;I): " + preparedText);

        // Step 2: Encrypt
        String encrypted = pc.encrypt(plaintext);
        System.out.println("Encrypted text: " + encrypted);

        // Step 3: Decrypt
        String decrypted = pc.decrypt(encrypted);
        System.out.println("Decrypted text (may contain padding X): " + decrypted);

        sc.close();
    }
}
