Encrypted text: ITSSG VGKSR!
Decrypted text: HELLO WORLD!




// affine cipher



import java.util.Scanner;

public class AffineCipher {
    private static final int m = 26; // size of alphabet

    // Find modular multiplicative inverse of a under modulo m
    public static int modInverse(int a, int m) {
        a = a % m;
        for (int x = 1; x &lt; m; x++) {
            if ((a * x) % m == 1) {
                return x;
            }
        }
        return -1; // inverse doesn't exist
    }

    // Encrypt plaintext using Affine cipher
    public static String encrypt(String plainText, int a, int b) {
        plainText = plainText.toUpperCase();
        StringBuilder cipherText = new StringBuilder();
        for (int i = 0; i &lt; plainText.length(); i++) {
            char ch = plainText.charAt(i);
            if (ch &gt;= 'A' &amp;&amp; ch &lt;= 'Z') {
                int x = ch - 'A';
                int encryptedChar = (a * x + b) % m;
                cipherText.append((char)(encryptedChar + 'A'));
            } else {
                cipherText.append(ch);
            }
        }
        return cipherText.toString();
    }

    // Decrypt ciphertext using Affine cipher
    public static String decrypt(String cipherText, int a, int b) {
        cipherText = cipherText.toUpperCase();
        StringBuilder plainText = new StringBuilder();
        int a_inv = modInverse(a, m);
        if (a_inv == -1) {
            return "Inverse does not exist, decryption not possible";
        }
        for (int i = 0; i &lt; cipherText.length(); i++) {
            char ch = cipherText.charAt(i);
            if (ch &gt;= 'A' &amp;&amp; ch &lt;= 'Z') {
                int y = ch - 'A';
                int decryptedChar = (a_inv * (y - b + m)) % m;
                plainText.append((char)(decryptedChar + 'A'));
            } else {
                plainText.append(ch);
            }
        }
        return plainText.toString();
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // a and m must be coprime, choose a accordingly
        int a = 5; 
        int b = 8;

        System.out.print("Enter text to encrypt: ");
        String input = sc.nextLine();

        String encrypted = encrypt(input, a, b);
        System.out.println("Encrypted text: " + encrypted);

        String decrypted = decrypt(encrypted, a, b);
        System.out.println("Decrypted text: " + decrypted);

        sc.close();
    }
}
