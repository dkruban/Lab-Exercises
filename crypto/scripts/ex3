// Miller Robin


import java.util.Scanner;

public class MillerRabin {
    // Perform modular exponentiation (base^exponent % mod)
    public static long modExp(long base, long exponent, long mod) {
        long result = 1;
        base = base % mod;
        while (exponent &gt; 0) {
            if ((exponent &amp; 1) == 1)
                result = (result * base) % mod;
            base = (base * base) % mod;
            exponent &gt;&gt;= 1;
        }
        return result;
    }

    // Miller-Rabin test for a single base 'a'
    private static boolean millerTest(long d, long n, long a) {
        long x = modExp(a, d, n);
        if (x == 1 || x == n - 1)
            return true;
        while (d != n - 1) {
            x = (x * x) % n;
            d &lt;&lt;= 1;
            if (x == 1) return false;
            if (x == n - 1) return true;
        }
        return false;
    }

    // Miller-Rabin primality test
    public static boolean isPrime(long n, int k) {
        if (n &lt;= 1 || n == 4) return false;
        if (n &lt;= 3) return true;

        long d = n - 1;
        while (d % 2 == 0)
            d /= 2;

        for (int i = 0; i &lt; k; i++) {
            long a = 2 + (long)(Math.random() * (n - 4));
            if (!millerTest(d, n, a))
                return false;
        }
        return true;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number to test primality: ");
        long n = sc.nextLong();

        int iterations = 5; // number of accuracy iterations
        boolean result = isPrime(n, iterations);

        if (result)
            System.out.println(n + " is probably prime.");
        else
            System.out.println(n + " is composite.");

        sc.close();
    }
}
Test case in command prompt:

&gt; javac MillerRabin.java
&gt; java MillerRabin
Enter number to test primality: 97
97 is probably prime.

&gt; java MillerRabin
Enter number to test primality: 100
100 is composite.



// EuclideanAlgorithm



import java.util.Scanner;

public class EuclideanAlgorithm {
    // Compute GCD of two numbers using Euclidean algorithm
    public static int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first number: ");
        int a = sc.nextInt();

        System.out.print("Enter second number: ");
        int b = sc.nextInt();

        int result = gcd(a, b);
        System.out.println("GCD of " + a + " and " + b + " is: " + result);

        sc.close();
    }
}
Test case in command prompt:

&gt; javac EuclideanAlgorithm.java
&gt; java EuclideanAlgorithm
Enter first number: 56
Enter second number: 98
GCD of 56 and 98 is: 14



// primitive roots 



import java.util.Scanner;

public class PrimitiveRoots {
    // Compute gcd of two numbers
    public static int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    // Compute power with modulo (base^exp % mod)
    public static long modExp(long base, long exp, long mod) {
        long result = 1;
        base = base % mod;
        while (exp &gt; 0) {
            if ((exp &amp; 1) == 1)
                result = (result * base) % mod;
            base = (base * base) % mod;
            exp &gt;&gt;= 1;
        }
        return result;
    }

    // Check if g is a primitive root modulo p
    public static boolean isPrimitiveRoot(int g, int p) {
        if (g &lt;= 0 || g &gt;= p) return false;
        int phi = p - 1;

        // Find prime factors of phi
        java.util.ArrayList&lt;Integer&gt; factors = new java.util.ArrayList&lt;&gt;();
        int n = phi;
        for (int i = 2; i * i &lt;= n; i++) {
            if (n % i == 0) {
                factors.add(i);
                while (n % i == 0)
                    n /= i;
            }
        }
        if (n &gt; 1) factors.add(n);

        // Check if g^((p-1)/factor) mod p != 1 for all prime factors
        for (int factor : factors) {
            if (modExp(g, phi / factor, p) == 1)
                return false;
        }
        return true;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a prime number p: ");
        int p = sc.nextInt();

        System.out.print("Enter a number g to check if it is a primitive root modulo " + p + ": ");
        int g = sc.nextInt();

        if (isPrimitiveRoot(g, p))
            System.out.println(g + " is a primitive root modulo " + p + ".");
        else
            System.out.println(g + " is NOT a primitive root modulo " + p + ".");

        sc.close();
    }
}
Test case in command prompt:

&gt; javac PrimitiveRoots.java
&gt; java PrimitiveRoots
Enter a prime number p: 7
Enter a number g to check if it is a primitive root modulo 7: 3
3 is a primitive root modulo 7.

&gt; java PrimitiveRoots
Enter a prime number p: 7
Enter a number g to check if it is a primitive root modulo 7: 2
2 is NOT a primitive root modulo 7.




